@page "/"
@inherits PlatformComponentBase
@using Volo.Abp.AspNetCore.Components.Web.Theming.MudBlazor.Layout
@inject PageLayout PageLayout
@{
    PageLayout.Title = L["Menu:Home"];
    PageLayout.ShowToolbar = false;
}

<div class="hse-home">
    <div class="hse-hero">
        <MudText Typo="Typo.h4" Class="mb-2">@L["Welcome"]</MudText>
        <MudText Typo="Typo.body1">@L["HomeLead"]</MudText>
        <MudText Typo="Typo.body2" Style="opacity:.85" Class="mt-2">@L["LongWelcomeMessage"]</MudText>
        @if (!CurrentUser.IsAuthenticated)
        {
            <MudButton Href="/Account/Login" Variant="Variant.Filled" Color="Color.Surface" Class="mt-4"
                       StartIcon="@Icons.Material.Filled.Login">@L["Login"]</MudButton>
        }
    </div>

    <MudGrid>
        <MudItem xs="12" md="6" lg="4">
            <MudPaper Class="hse-page-card hse-module-card pa-5" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.Groups" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h6" Class="mt-3 mb-2">@L["Employees"]</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">@L["HomeEmployeesDescription"]</MudText>
                <MudButton Href="/organization/employees" Variant="Variant.Filled" Color="Color.Primary"
                           EndIcon="@Icons.Material.Filled.ArrowForward">@L["OpenEmployees"]</MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
</div>
