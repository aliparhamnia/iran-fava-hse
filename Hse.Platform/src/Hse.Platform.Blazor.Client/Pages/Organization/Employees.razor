@page "/organization/employees"
@attribute [Authorize(PlatformPermissions.Employees.Default)]
@inherits PlatformComponentBase
@using Hse.Platform.Organization
@using Hse.Platform.Permissions
@using Hse.Platform.Blazor.Client.Components
@using Volo.Abp.AspNetCore.Components.Web.Theming.MudBlazor.Layout
@inject IEmployeeAppService EmployeeAppService
@inject PageLayout PageLayout
@inject IDialogService DialogService

@{
    PageLayout.Title = L["Employees"];
}

<MudStack Row="true" Spacing="2" Class="mb-4" AlignItems="AlignItems.Center">
    <MudTextField @bind-Value="_filter" Label="@L["Search"]" Immediate="true" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchAsync">@L["Search"]</MudButton>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateAsync">@L["CreateEmployee"]</MudButton>
</MudStack>

<MudTable Items="_items" Hover="true" Loading="_loading" Breakpoint="Breakpoint.Sm">
    <HeaderContent>
        <MudTh>@L["EmployeeNumber"]</MudTh>
        <MudTh>@L["FirstName"]</MudTh>
        <MudTh>@L["LastName"]</MudTh>
        <MudTh>@L["HireDate"]</MudTh>
        <MudTh>@L["Status"]</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.EmployeeNumber</MudTd>
        <MudTd>@context.FirstName</MudTd>
        <MudTd>@context.LastName</MudTd>
        <MudTd>@context.HireDate</MudTd>
        <MudTd>@L[$"Enum:EmployeeStatus.{(int)context.Status}"]</MudTd>
        <MudTd>
            @if (context.Status == EmployeeStatus.Active)
            {
                <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => TerminateAsync(context)">@L["Terminate"]</MudButton>
            }
        </MudTd>
    </RowTemplate>
</MudTable>

<MudPagination Count="_pageCount" SelectedChanged="OnPageChanged" Class="mt-4" />

@code {
    private readonly List<EmployeeDto> _items = [];
    private string? _filter;
    private bool _loading;
    private int _page = 1;
    private int _pageCount = 1;
    private const int PageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task SearchAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await EmployeeAppService.GetListAsync(new GetEmployeeListInput
            {
                Filter = _filter,
                SkipCount = (_page - 1) * PageSize,
                MaxResultCount = PageSize
            });
            _items.Clear();
            _items.AddRange(result.Items);
            _pageCount = Math.Max(1, (int)Math.Ceiling(result.TotalCount / (double)PageSize));
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateAsync()
    {
        var parameters = new DialogParameters { ["OnSaved"] = EventCallback.Factory.Create(this, LoadAsync) };
        await DialogService.ShowAsync<CreateEmployeeDialog>(L["CreateEmployee"], parameters);
    }

    private async Task TerminateAsync(EmployeeDto employee)
    {
        await EmployeeAppService.TerminateAsync(employee.Id);
        await LoadAsync();
    }
}
